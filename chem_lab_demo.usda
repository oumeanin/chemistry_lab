#usda 1.0
(
    customLayerData = {
        dictionary cameraSettings = {
            dictionary Perspective = {
                double3 position = (-9.6533, 1.0845, 0.6561)
                double3 target = (-4.856, 4.7249, -3.8533)
            }
            string boundCamera = "/OmniverseKit_Persp"
        }
        string comment = "built by build_demo_layer.py (sublayer: chem_lab_scene.usda)"
        dictionary renderSettings = {
            bool "rtx:flow:enabled" = 1
            bool "rtx:flow:pathTracingEnabled" = 1
            bool "rtx:flow:rayTracedReflectionsEnabled" = 1
            bool "rtx:flow:rayTracedTranslucencyEnabled" = 1
        }
    }
    defaultPrim = "World"
    endTimeCode = 36000
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./chem_lab_scene.usda@
    ]
    timeCodesPerSecond = 60
    upAxis = "Z"
)

over "physicsScene" (
    prepend apiSchemas = ["PhysxSceneAPI"]
)
{
    uniform token physxScene:broadphaseType = "GPU"
    bool physxScene:enableGPUDynamics = 1
}

over "Beaker" (
    active = false
)
{
}


def Xform "DemoFX"
{
    def PhysxParticleSystem "FluidSystem" (
        prepend apiSchemas = ["PhysxParticleAnisotropyAPI", "PhysxParticleSmoothingAPI", "PhysxParticleIsosurfaceAPI", "MaterialBindingAPI"]
    )
    {
        bool enableCCD = 1
        rel material:binding = </Looks/HazardFluid>
        rel material:binding:physics = </Looks/HazardFluid>
        float maxVelocity = 6
        float particleContactOffset = 0.003
        float physxParticleAnisotropy:max = 2
        float physxParticleAnisotropy:min = 1
        bool physxParticleAnisotropy:particleAnisotropyEnabled = 1
        float physxParticleAnisotropy:scale = 5
        string physxParticleIsosurface:gridFilteringPasses = "GSRS"
        float physxParticleIsosurface:gridSmoothingRadius = 0.005346
        float physxParticleIsosurface:gridSpacing = 0.0021384
        bool physxParticleIsosurface:isosurfaceEnabled = 1
        int physxParticleIsosurface:numMeshNormalSmoothingPasses = 6
        int physxParticleIsosurface:numMeshSmoothingPasses = 6
        float physxParticleIsosurface:surfaceDistance = 0.007128
        bool physxParticleSmoothing:particleSmoothingEnabled = 1
        float physxParticleSmoothing:strength = 0.8
        rel simulationOwner = </physicsScene>
        int solverPositionIterationCount = 8
    }

    def Points "HazardFluid" (
        prepend apiSchemas = ["PhysxParticleSetAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/HazardFluid>
        float physics:density = 1000
        float physics:mass = 0
        bool physxParticle:fluid = 1
        int physxParticle:particleGroup = 0

    def Xform "DeskBeaker_1" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        prepend references = @./chem_lab/lab.usd@</root/Lab/ST_Acc_BechersGlass03_mo>
    )
    {
        float physics:mass = 0.05
        float3 xformOp:rotateXYZ = (0, 0, 0)
        double3 xformOp:translate = (-4.32, 3.99, -1.901)

        over "ST_Acc_BechersGlass03_md" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxSDFMeshCollisionAPI", "MaterialBindingAPI"]
        )
        {
